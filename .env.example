# =============================================================================
# 拼好车环境变量模板（docker-compose 专用）
#
# 用法：
#   cp .env.example .env      # Git Bash / macOS / Linux
#   copy .env.example .env    # Windows CMD / PowerShell
# 然后按下文的【A】或【B】修改 .env，在项目根目录执行：
#   docker compose up -d --build
#
# docker compose 会自动读取项目根目录的 .env（无需 --env-file 参数），
# 该文件已写入 .gitignore，**绝不要把真实 AppSecret 提交进版本库**。
# 完整可照抄的操作步骤见 docs/RUNBOOK.md。
# =============================================================================

# -----------------------------------------------------------------------------
# 基础设施凭证（启动前必须替换；不要把实际 .env 提交）
# -----------------------------------------------------------------------------
# 用 PowerShell 生成（仅含 .env 安全的十六进制字符）：
# [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# 每个密码分别执行一次；也可用 openssl rand -hex 32。
# MYSQL_DATABASE 与 MYSQL_USER 可保留为非敏感固定名称；其余值必须各不相同的随机字符串。
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=pinhaoche
MYSQL_USER=pinhaoche
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
RABBITMQ_USER=pinhaoche_service
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_RABBITMQ_PASSWORD
ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY

# 默认只允许本机访问后端。手机通过可信组网访问时，填本机在该组网中的虚拟 IP，例如 192.168.188.1。
# 不要填 0.0.0.0，除非你明确需要向所有本地网络接口暴露 API，且已由反向代理/防火墙限制。
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 头像上传落盘目录（相对容器工作目录 /app），须与 docker-compose.yml 的挂载点一致。
UPLOAD_DIR=./data/uploads

# =============================================================================
# 【A 本地联调（默认，下面这几行保持原样即可）】
# 不需要微信 AppSecret、不需要真机，任何人 clone 下来就能跑。
# 后端把登录 code 直接当 openid 用（mock 网关）；小程序侧 config.ts 的 MODE = 'mock'。
# 注意：两边必须同时处于 mock，一边 real 一边 mock 时登录必然 401。
# =============================================================================
WECHAT_MOCK=true
# mock 模式下 appid/secret 不参与登录，留空即可
WECHAT_APPID=
WECHAT_SECRET=

# =============================================================================
# 【B 真实微信模式】—— 体验"真实上线"：真实 wx.login + 真实 openid + 真实头像昵称
#
# 做法：
#   1) 把下面 A 段的三行 WECHAT_MOCK / WECHAT_APPID / WECHAT_SECRET 换成这三行：
#
# WECHAT_MOCK=false
# WECHAT_APPID=wxe956226c7e7fa726
# WECHAT_SECRET=在此填入你的AppSecret
#
#   2) 确认上方所有基础设施密码和 ADMIN_KEY 均已替换为强随机值。
#
# 然后（缺一不可，详见 docs/RUNBOOK.md 第 6 节）：
#   1) docker compose up -d --build server    # 只重建后端，MySQL 数据不动
#   2) miniprogram/config.ts 里 MODE 改成 'real'
#   3) 微信开发者工具点"编译"，进"我的"页点"重新登录"
#
# AppSecret 从哪里拿：
#   微信公众平台 https://mp.weixin.qq.com → 用小程序管理员账号登录 →
#   左侧「开发管理」→「开发设置」→「开发者ID」→ AppSecret 一行点「重置/生成」。
#   只完整显示一次，请立即复制保存；泄露需马上重置（重置后旧的 Secret 立即失效）。
#
# WECHAT_APPID 就是 miniprogram/project.config.json 里已注册的真实 appid，无需改动。
# ADMIN_KEY 必须是强随机值；它与数据库、Redis、RabbitMQ 密码不得复用。
# =============================================================================
