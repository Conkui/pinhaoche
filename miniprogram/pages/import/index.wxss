/* 导入页 */
.share-input {
  width: 100%;
  min-height: 160rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.picker-row {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: #111827;
}

.plate-input {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.wait-chip {
  background: #f9fafb;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  color: #6b7280;
}

.wait-chip-on {
  background: #eef1f6;
  color: #576b95;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 12rpx;
  width: fit-content;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #576b95;
  font-size: 40rpx;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-weight: 600;
}
