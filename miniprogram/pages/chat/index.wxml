<view class="conn-tip" wx:if="{{!connected}}">连接已断开，正在重连…</view>

<scroll-view scroll-y scroll-top="{{scrollTop}}" class="chat-scroll" enhanced show-scrollbar="{{false}}">
  <view wx:if="{{historyLoading}}" class="state-block">加载聊天记录…</view>
  <view wx:elif="{{historyFailed}}" class="state-block">
    <view>聊天记录加载失败</view>
    <view class="retry" bindtap="retryHistory">点击重试</view>
  </view>

  <block wx:for="{{bubbles}}" wx:key="key">
    <view class="row {{item.mine ? 'row-mine' : ''}}">
      <view class="bubble {{item.mine ? 'bubble-mine' : ''}}" data-mid="{{item.messageId}}"
            data-mine="{{item.mine}}" data-state="{{item.state}}" catchlongpress="onBubbleLongPress">
        <text>{{item.content}}</text>
      </view>
      <view class="bubble-meta" wx:if="{{item.mine}}">
        <text wx:if="{{item.state === 'sending'}}" class="state-sending">发送中</text>
        <text wx:elif="{{item.state === 'failed'}}" class="state-failed" data-cmid="{{item.clientMsgId}}" catchtap="retrySend">失败·重试</text>
        <text wx:else class="state-acked">已送达</text>
      </view>
      <view class="bubble-meta" wx:else>{{item.time}}</view>
    </view>
  </block>
</scroll-view>

<view wx:if="{{deleteMenuVisible}}" class="delete-menu-mask" catchtap="closeDeleteMenu">
  <view class="delete-menu" style="left: {{deleteMenuLeft}}px; top: {{deleteMenuTop}}px;" catchtap="deleteSelectedMessage">删除</view>
</view>

<view class="quick-bar">
  <view class="quick-chip" wx:for="{{quickTexts}}" wx:key="*this" data-text="{{item}}" bindtap="onQuickText">
    {{item}}
  </view>
</view>

<view class="input-bar">
  <input class="chat-input" value="{{input}}" bindinput="onInput" confirm-type="send"
         bindconfirm="onSend" placeholder="输入消息…" maxlength="2000" />
  <view class="send-btn {{input ? '' : 'send-btn-off'}}" bindtap="onSend">发送</view>
</view>
