/* 聊天页（RFC-007 视觉升级）：我方气泡用主色轻渐变、对方白色；
   投影只用于输入栏（浅投影，透明度远低于 0.25 红线），气泡不加阴影 */
page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 与全局令牌统一：#f3f4f6 → #f5f7fa */
  background: #f5f7fa;
}

/* 断线提示：warning 功能色的浅底深字，保持克制 */
.conn-tip {
  background: #fffbe6;
  color: #d48806;
  font-size: 24rpx;
  text-align: center;
  padding: 8rpx 0;
}

.chat-scroll {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.row-mine {
  align-items: flex-end;
}

/* 对方气泡：白底 + 与页面背景区分的极浅描边，不加阴影 */
.bubble {
  max-width: 70%;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  word-break: break-all;
}

/* 我方气泡：与主按钮一致的自顶向下主色轻渐变（RFC-007 允许的轻渐变），
   让"我的消息"与 Primary Action 同源，视觉身份统一 */
.bubble-mine {
  background: linear-gradient(180deg, #4096ff, #1677ff);
  border: none;
  color: #ffffff;
}

/* 时间/状态小字：22rpx 辅助层，弱到不干扰阅读 */
.bubble-meta {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 失败态用 danger 功能色 #ff4d4f，与全局语义一致 */
.state-failed {
  color: #ff4d4f;
}

/* 快捷文本条：浅灰底衬托白色 chips */
.quick-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: #f9fafb;
}

/* 快捷 chips：白底圆角 + 极浅主色描边，可点但不抢主输入框的视觉 */
.quick-chip {
  background: #ffffff;
  border: 1rpx solid rgba(22, 119, 255, 0.2);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #374151;
}

/* 输入栏吸底：浅投影向上晕开，把输入区和消息流分层（投影透明度 ≤ 0.25 红线内） */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.chat-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
}

/* 发送按钮：与全局 primary 同源的主色渐变，保证跨页面视觉一致 */
.send-btn {
  background: linear-gradient(180deg, #4096ff, #1677ff);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 36rpx;
  font-size: 30rpx;
}

/* 禁用态：固定浅蓝 #bbcaf4 无投影，与全局 btn-primary.disabled 同一语义 */
.send-btn-off {
  background: #bbcaf4;
}
