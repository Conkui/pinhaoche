/* 发布页局部样式 */
.picker-row {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: #111827;
}

.stepper {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 12rpx;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #576b95;
  font-size: 40rpx;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-weight: 600;
}

.remark-input {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
