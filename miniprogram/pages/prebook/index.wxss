/* 预打车页：状态标签语义着色 + 详情入口暗示；基础令牌走全局 app.wxss */

/* 标题行：路线占满、右侧留浅灰 ›，仅作视觉暗示，不新增点击热区 */
.prebook-head {
  display: flex;
  align-items: center;
}

.prebook-head .route-line {
  flex: 1;
}

.prebook-chevron {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #9ca3af;
}

/* ---------- 联系发布者：弱化次级小按钮（用户 2026-09-14） ----------
   本页 Primary 是悬浮吸底的"发布预打车"，联系入口改为浅蓝底 #e8f1ff +
   主色文字 + 胶囊圆角，高度 60rpx / 字号 26rpx，视觉优先级明显低于主按钮。
   不复用全局 .btn-plain（30rpx 字号 + 16rpx 圆角偏大，仍会与主按钮抢层级）。 */
.btn-contact-mini {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  color: #1677ff;
  background: #e8f1ff;
  border-radius: 999rpx;
}

/* ---------- 悬浮发布按钮（本页唯一 Primary Action） ---------- */

/* 吸底固定 + 宽度 70% 居中：发布是本页核心转化入口，任何滚动位置都必须可见；
   底部叠加 iPhone 底部安全区（tab 页 webview 在原生 tabBar 之上，非 tab 场景也能兜底）。
   渐变与投影复用全局 .btn-primary，此类只负责定位，避免复制视觉令牌。 */
.publish-fab {
  position: fixed;
  left: 15%;
  right: 15%;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 100;
}

/* 列表底部占位：按钮高约 92rpx + 距底 32rpx + 上下呼吸空间，再叠加底部安全区，
   保证最后一张卡完整可读、可点击，不被悬浮按钮遮挡 */
.fab-safe-space {
  height: calc(240rpx + env(safe-area-inset-bottom));
}

/* 停用态只保留公告和刷新：服务关闭不是空数据，使用克制的信息层级避免误导成加载失败。 */
.feature-closed {
  margin: 120rpx 24rpx;
  padding: 48rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: left;
}

.feature-closed-title {
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.feature-closed-announcement {
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 顶部双端路线筛选：保持白卡片与低对比辅助操作，避免与“发布预打车”主操作竞争。 */
.route-filter-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.route-filter-head,
.route-filter-row,
.route-filter-trigger,
.route-custom-row {
  display: flex;
  align-items: center;
}

.route-filter-head {
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.route-filter-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.route-filter-reset,
.route-filter-retry {
  color: #1677ff;
  font-size: 26rpx;
}

.route-filter-row {
  gap: 16rpx;
}

.route-filter-picker {
  flex: 1;
  min-width: 0;
}

.route-filter-trigger {
  min-width: 0;
  padding: 18rpx 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.route-filter-label {
  flex-shrink: 0;
  color: #6b7280;
  font-size: 24rpx;
}

.route-filter-value {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-filter-set {
  color: #1f2937;
}

.route-filter-tip,
.route-filter-retry {
  margin-top: 16rpx;
}

.route-custom-row {
  gap: 16rpx;
  margin-top: 16rpx;
}

.route-custom-input {
  flex: 1;
  min-width: 0;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.route-custom-confirm {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  color: #fff;
  background: #1677ff;
  border-radius: 12rpx;
  font-size: 26rpx;
}
