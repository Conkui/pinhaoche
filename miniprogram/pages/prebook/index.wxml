<view wx:if="{{loading}}" class="state-block">加载中…</view>

<!-- 运营关闭实时拼时，列表与发布入口必须整体替换，不能只把按钮置灰后仍展示过时订单。 -->
<view wx:elif="{{!realtimeEnabled}}" class="state-block feature-closed">
  <view class="feature-closed-title">实时拼暂未开放</view>
  <view class="meta feature-closed-announcement">{{announcement}}</view>
  <view class="retry" bindtap="retry">点击刷新</view>
</view>

<view wx:elif="{{loadFailed}}" class="state-block">
  <view>加载失败</view>
  <view class="retry" bindtap="retry">点击重试</view>
</view>

<block wx:else>
  <!-- 路线筛选始终位于服务列表顶部；预设下拉与“其他输入”均只作用于本地快照。 -->
  <view class="route-filter-card">
    <view class="route-filter-head">
      <view class="route-filter-title">筛选路线</view>
      <view class="route-filter-reset" bindtap="resetRouteFilter">重置</view>
    </view>
    <view class="route-filter-row">
      <picker mode="selector" range="{{placeOptions}}" bindchange="onOriginPick" class="route-filter-picker">
        <view class="route-filter-trigger">
          <text class="route-filter-label">出发地</text>
          <text class="route-filter-value {{originFilterText ? 'route-filter-set' : ''}}">{{originFilterText || '不限'}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
      <picker mode="selector" range="{{placeOptions}}" bindchange="onDestinationPick" class="route-filter-picker">
        <view class="route-filter-trigger">
          <text class="route-filter-label">目的地</text>
          <text class="route-filter-value {{destinationFilterText ? 'route-filter-set' : ''}}">{{destinationFilterText || '不限'}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view wx:if="{{placesLoading}}" class="meta route-filter-tip">地点加载中，也可选择“其他输入”</view>
    <view wx:if="{{placesError}}" class="route-filter-retry" bindtap="loadPlaces">预设地点加载失败，点击重试</view>
    <view wx:if="{{originCustomOpen}}" class="route-custom-row">
      <input class="route-custom-input" value="{{originCustomDraft}}" bindinput="onOriginCustomInput" maxlength="100" placeholder="输入出发地筛选" />
      <view class="route-custom-confirm" bindtap="confirmOriginCustom">确定</view>
    </view>
    <view wx:if="{{destinationCustomOpen}}" class="route-custom-row">
      <input class="route-custom-input" value="{{destinationCustomDraft}}" bindinput="onDestinationCustomInput" maxlength="100" placeholder="输入目的地筛选" />
      <view class="route-custom-confirm" bindtap="confirmDestinationCustom">确定</view>
    </view>
  </view>

  <view wx:if="{{cards.length === 0}}" class="state-block">
    <!-- 空态文案由 ts 侧区分：无订单 / 路线无匹配 / 无可加入订单。 -->
    <view>{{emptyTitle}}</view>
    <view class="meta">{{emptySub}}</view>
  </view>

  <view wx:if="{{cards.length > 0}}" class="card" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <!-- 标题行右侧浅灰 ›：暗示整卡可点进详情（点击行为仍是原有的 bindtap） -->
    <view class="prebook-head">
      <view class="route-line">{{item.route}}</view>
      <view class="prebook-chevron">›</view>
    </view>
    <view class="meta" style="margin-top:8rpx">今天 {{item.depart}} 出发</view>
    <view class="meta">已有 {{item.joined}} 人 · 还可加入 {{item.seats}} 人</view>
    <view class="meta" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    <!-- 状态标签按语义着色（ts 侧映射）：待同行=蓝 info、匹配中=绿 success、已满/过期=灰 neutral -->
    <view style="margin-top:16rpx"><text class="{{item.statusClass}}">{{item.statusLabel}}</text></view>
    <!-- 联系发布者弱化为次级小按钮（浅蓝底胶囊）：视觉优先级必须明显低于
         悬浮吸底的"发布预打车"主按钮，避免两个 primary 抢焦点（用户 2026-09-14） -->
    <view style="margin-top:20rpx" wx:if="{{item.joinable}}">
      <view class="btn-contact-mini" data-id="{{item.id}}" catchtap="contactOwner">联系发布者</view>
    </view>
  </view>
</block>

<!-- 底部安全占位：悬浮按钮固定吸底，列表末尾留足空间，防止最后一张卡被遮挡 -->
<view wx:if="{{realtimeEnabled}}" class="fab-safe-space"></view>

<!-- 悬浮发布按钮：本页唯一 Primary Action，复用全局 .btn-primary 渐变+投影，
     本元素只附加定位样式；固定吸底保证任意滚动位置都能发布 -->
<view wx:if="{{realtimeEnabled}}" class="publish-fab btn-primary" bindtap="goPublish">发布预打车</view>
