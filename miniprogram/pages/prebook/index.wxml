<view wx:if="{{loading}}" class="state-block">加载中…</view>

<!-- 运营关闭实时拼时，列表与发布入口必须整体替换，不能只把按钮置灰后仍展示过时订单。 -->
<view wx:elif="{{!realtimeEnabled}}" class="state-block feature-closed">
  <view class="feature-closed-title">实时拼暂未开放</view>
  <view class="meta feature-closed-announcement">{{announcement}}</view>
  <view class="retry" bindtap="retry">点击刷新</view>
</view>

<view wx:elif="{{loadFailed}}" class="state-block">
  <view>加载失败</view>
  <view class="retry" bindtap="retry">点击重试</view>
</view>

<view wx:elif="{{cards.length === 0}}" class="state-block">
  <!-- 空态两种文案由 ts 侧计算：没人发布 / 有单但全部不可加入（被数据层过滤） -->
  <view>{{emptyTitle}}</view>
  <view class="meta">{{emptySub}}</view>
</view>

<block wx:else>
  <view class="card" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <!-- 标题行右侧浅灰 ›：暗示整卡可点进详情（点击行为仍是原有的 bindtap） -->
    <view class="prebook-head">
      <view class="route-line">{{item.route}}</view>
      <view class="prebook-chevron">›</view>
    </view>
    <view class="meta" style="margin-top:8rpx">今天 {{item.depart}} 出发</view>
    <view class="meta">已有 {{item.joined}} 人 · 还可加入 {{item.seats}} 人</view>
    <view class="meta" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    <!-- 状态标签按语义着色（ts 侧映射）：待同行=蓝 info、匹配中=绿 success、已满/过期=灰 neutral -->
    <view style="margin-top:16rpx"><text class="{{item.statusClass}}">{{item.statusLabel}}</text></view>
    <!-- 联系发布者弱化为次级小按钮（浅蓝底胶囊）：视觉优先级必须明显低于
         悬浮吸底的"发布预打车"主按钮，避免两个 primary 抢焦点（用户 2026-09-14） -->
    <view style="margin-top:20rpx" wx:if="{{item.joinable}}">
      <view class="btn-contact-mini" data-id="{{item.id}}" catchtap="contactOwner">联系发布者</view>
    </view>
  </view>
</block>

<!-- 底部安全占位：悬浮按钮固定吸底，列表末尾留足空间，防止最后一张卡被遮挡 -->
<view wx:if="{{realtimeEnabled}}" class="fab-safe-space"></view>

<!-- 悬浮发布按钮：本页唯一 Primary Action，复用全局 .btn-primary 渐变+投影，
     本元素只附加定位样式；固定吸底保证任意滚动位置都能发布 -->
<view wx:if="{{realtimeEnabled}}" class="publish-fab btn-primary" bindtap="goPublish">发布预打车</view>
